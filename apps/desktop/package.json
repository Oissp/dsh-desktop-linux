{
  "name": "@deepseek-ai/dsh-desktop",
  "productName": "DeepSeek Harness",
  "description": "Electron desktop shell for a bundled dsh runtime and external plugins",
  "author": "Oissp <19642615+Oissp@users.noreply.github.com>",
  "homepage": "https://github.com/Oissp/dsh-desktop-linux",
  "version": "0.1.7-rc.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -b && pnpm run bundle",
    "bundle": "tsdown",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts --skip-build",
    "prepare:runtime": "tsx scripts/prepare-runtime.ts",
    "render:tray-icon": "tsx scripts/render-tray-icon.ts",
    "prepare:packages": "tsx scripts/prepare-package-set.ts",
    "prepare:dsh": "tsx scripts/prepare-dsh.ts",
    "prepare:package": "tsx scripts/package-target.ts --prepare-only",
    "package": "tsx scripts/package-target.ts",
    "package:dir": "tsx scripts/package-target.ts --dir",
    "package:linux:x64": "tsx scripts/package-target.ts linux-x64",
    "prepare:linux:x64": "tsx scripts/package-target.ts linux-x64 --prepare-only",
    "package:linux:x64:builder": "tsx scripts/package-target.ts linux-x64 --builder-only",
    "package:linux:x64:dir": "tsx scripts/package-target.ts linux-x64 --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "ws": "^8.21.0",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "workspace:*",
    "@deepseek-ai/dsh-deepseek-account": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/node-addon-system": "workspace:~",
    "@electron/get": "^5.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "app-builder-lib": "26.15.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.2.0",
    "pnpm": "11.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "sharp": "^0.35.3",
    "tar": "^7.5.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:*",
    "@deepseek-ai/dsh-client-shortcuts": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*"
  }
}
